# Server
PORT=5000

# Client origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fypwms

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m

# File uploads (optional — defaults to local ./uploads directory)
# UPLOAD_DIR=/var/data/uploads

# Default password for newly created students — shown publicly on the login
# page. Students log in with this once, then must set their own password.
# Change it periodically; optional, defaults to "Student@2026" if unset.
# DEFAULT_STUDENT_PASSWORD=Student@2026

# Email — Brevo transactional API (passwords, OTPs, notifications)
# HTTPS-based; works on hosts that block SMTP ports (e.g. Render free tier).
# 1. Sign up free at https://www.brevo.com (300 emails/day)
# 2. Verify your sender address: Brevo dashboard → Senders & IPs → Senders
# 3. Create an API key: dashboard → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here
# Must be a sender address you verified in Brevo (your Gmail works)
EMAIL_FROM=your_address@gmail.com
# Display name shown as the sender (optional, defaults to FYP-WMS)
# EMAIL_FROM_NAME=FYP-WMS

# SMS — smsonlinegh.com
# Get your API key from your smsonlinegh.com account dashboard
SMS_API_KEY=your_smsonlinegh_api_key_here
# Sender name must be registered in your smsonlinegh.com account under SMS Messaging
SMS_SENDER=your_sender_name_here

# Gemini — AI-assisted project topic suggestions (free tier)
# Get a free API key from https://ai.google.dev / Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
# Check ai.google.dev for the current free-tier model name if this stops working
# (gemini-2.0-flash has NO free-tier quota anymore — use a 2.5 model)
GEMINI_MODEL=gemini-2.5-flash-lite
